;; ================================================================
;; QC RocketStart - Bonding Curve Logic
;; ================================================================
;; Price calculation functions for the linear bonding curve
;; 
;; Formula: price(supply) = INITIAL_PRICE + (supply * CURVE_SLOPE / MAX_SUPPLY)
;; ================================================================

#include "constants.fc";

;; ----- Get Current Token Price -----
;; Returns price in nano-TON per token
(int) get_current_price(int current_supply) inline {
    return INITIAL_PRICE + muldiv(current_supply, CURVE_SLOPE, MAX_SUPPLY);
}

;; ----- Calculate Tokens for TON Amount (Buy) -----
;; Uses spot price for simplicity (linear approximation)
;; Returns: token amount (in nano)
(int) calculate_buy_price(int ton_amount, int current_supply) inline {
    int current_price = INITIAL_PRICE + muldiv(current_supply, CURVE_SLOPE, MAX_SUPPLY);
    
    ;; Prevent division by zero or negative prices
    if (current_price < INITIAL_PRICE) {
        current_price = INITIAL_PRICE;
    }
    
    ;; tokens = ton_amount / price
    int tokens_out = muldiv(ton_amount, ONE_TOKEN, current_price);
    return tokens_out;
}

;; ----- Calculate TON for Token Amount (Sell) -----
;; Uses average price across the sell range for accuracy
;; Returns: TON amount (in nano)
(int) calculate_sell_return(int token_amount, int current_supply) inline {
    ;; Can't sell more than supply
    if (token_amount > current_supply) {
        token_amount = current_supply;
    }
    
    ;; Calculate average price across the sell range
    int supply_after = current_supply - token_amount;
    int avg_price = INITIAL_PRICE + muldiv(supply_after + token_amount / 2, CURVE_SLOPE, MAX_SUPPLY);
    
    ;; ton_out = tokens * avg_price
    int ton_out = muldiv(token_amount, avg_price, ONE_TOKEN);
    return ton_out;
}

;; ----- Calculate Buy with Exact Output -----
;; For slippage protection: given desired tokens, how much TON needed?
(int) calculate_ton_for_tokens(int token_amount, int current_supply) inline {
    ;; Average price for the range we're buying
    int supply_after = current_supply + token_amount;
    int avg_price = INITIAL_PRICE + muldiv(current_supply + token_amount / 2, CURVE_SLOPE, MAX_SUPPLY);
    
    int ton_needed = muldiv(token_amount, avg_price, ONE_TOKEN);
    return ton_needed;
}
