rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read: if request.auth !=null // Sadece kendi verilerini okuyabilir
      allow write: if request.auth !=null ; // Sadece kendi verilerini yazabilir
    }
    match /user/{userId}/{document=**} {
      allow read: if request.auth !=null // Sadece kendi verilerini okuyabilir
      allow write: if request.auth !=null ; // Sadece kendi verilerini yazabilir
    }
    
    // AI Usage rate limiting - allow server to read/write
    match /user/{userId}/aiUsage/{document=**} {
      allow read, write: if true; // Server-side access for rate limiting
    }
    match /userAddresses/{document=**} {
      allow read: if false;
    }
    match /userRanks/{userId}/{document=**}{
    allow read:if request.auth !=null;
    allow write:if request.auth !=null;
    }
    match /tasks/{document=**}{
     allow read: if true;
    }
    match /set/{document=**}{
    allow read:if true;
    }
    
    // Groups - authenticated users can read/write
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
      
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
    
    // Chats - authenticated users can read/write their own chats
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
    
    // Tokens - trading platform
    match /tokens/{tokenId} {
      allow read: if true; // Anyone can view tokens
      allow create: if request.auth != null; // Only authenticated users can create
      allow update: if request.auth != null; // Trading updates (validated server-side)
      
      match /trades/{tradeId} {
        allow read: if true; // Trade history is public
        allow create: if request.auth != null;
      }
      
      match /holders/{holderId} {
        allow read: if true; // Holder data is public
        allow write: if request.auth != null;
      }
      
      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
    
    // CollectionGroup queries - allows querying trades across all tokens
    match /{path=**}/trades/{tradeId} {
      allow read: if true; // Anyone can read trades across all tokens
    }
    
    // Graduation queue - function/admin only write, public read for status
    match /graduationQueue/{queueId} {
      allow read: if true; // Anyone can check graduation status
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Graduation logs - public read for transparency
    match /graduationLogs/{logId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Trade logs - function only
    match /tradeLogs/{logId} {
      allow read: if false; // Admin only
      allow write: if false; // Only API routes can write
    }
  }
}
