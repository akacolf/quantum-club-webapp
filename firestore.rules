rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read: if request.auth !=null // Sadece kendi verilerini okuyabilir
      allow write: if request.auth !=null ; // Sadece kendi verilerini yazabilir
    }
    match /user/{userId}/{document=**} {
      allow read: if request.auth !=null // Sadece kendi verilerini okuyabilir
      allow write: if request.auth !=null ; // Sadece kendi verilerini yazabilir
    }
    match /userAddresses/{document=**} {
      allow read: if false;
    }
    match /userRanks/{userId}/{document=**}{
    allow read:if request.auth !=null;
    allow write:if request.auth !=null;
    }
    match /tasks/{document=**}{
     allow read: if true;
    }
    match /set/{document=**}{
    allow read:if true;
    }
    
    // Groups - authenticated users can read/write
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
      
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
    
    // Chats - authenticated users can read/write their own chats
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
  }
}



