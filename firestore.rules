rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /user/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // AI Usage rate limiting - server-side only via Admin SDK
    // Security: Deny direct client access to prevent rate limit bypass
    match /user/{userId}/aiUsage/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only server writes via Admin SDK
    }
    match /userAddresses/{document=**} {
      allow read: if false;
    }
    match /userRanks/{userId}/{document=**}{
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /tasks/{document=**}{
      allow read: if request.auth != null;
    }
    match /set/{document=**}{
    allow read:if true;
    }
    
    // Groups - authenticated users can read/create; only creator can delete
    // Membership is tracked in the /members subcollection (not queryable in rules),
    // so update is auth-gated; app-level logic enforces membership checks.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == memberId;
      }
    }
    
    // Chats - authenticated users can read/write their own chats
    match /chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
    
    // Tokens - trading platform
    // All token/trade/holder mutations use Admin SDK (server actions + Cloud Functions)
    match /tokens/{tokenId} {
      allow read: if true; // Anyone can view tokens
      allow create: if false; // Only server actions with Admin SDK can create
      allow update: if false; // Only server actions with Admin SDK can update

      match /trades/{tradeId} {
        allow read: if true; // Trade history is public
        allow create: if false; // Only server actions with Admin SDK can create
      }

      match /holders/{holderId} {
        allow read: if true; // Holder data is public
        allow write: if false; // Only server actions with Admin SDK can write
      }

      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }
    
    // CollectionGroup queries - allows querying trades across all tokens
    match /{path=**}/trades/{tradeId} {
      allow read: if true; // Anyone can read trades across all tokens
    }
    
    // Graduation queue - function/admin only write, public read for status
    match /graduationQueue/{queueId} {
      allow read: if true; // Anyone can check graduation status
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Graduation logs - public read for transparency
    match /graduationLogs/{logId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Trade logs - function only
    match /tradeLogs/{logId} {
      allow read: if false; // Admin only
      allow write: if false; // Only API routes can write
    }
    
    // Price history - candlestick data for charts
    match /priceHistory/{tokenId}/candles/{candleId} {
      allow read: if true; // Anyone can read price history
      allow write: if false; // Only server can write
    }
    
    // Wallet collection - user wallet data
    match /wallet/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deployment logs - server only
    match /deploymentLogs/{logId} {
      allow read: if false; // Admin only
      allow write: if false; // Only API routes can write
    }
    
    // User groups subcollection (already covered by user/{userId}/** but explicit for clarity)
    match /user/{userId}/groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User positions subcollection (already covered by users/{userId}/** but explicit for clarity)
    match /users/{userId}/positions/{tokenId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // CollectionGroup queries - allows querying positions across all users
    match /{path=**}/positions/{tokenId} {
      allow read: if request.auth != null;
    }
    
    // CollectionGroup queries - allows querying messages across all chats
    match /{path=**}/messages/{messageId} {
      allow read: if request.auth != null;
    }
    
    // QC Chat - end-to-end encrypted messaging
    // Auth required; participant filtering is app-level (encrypted IDs ≠ Firebase UIDs)
    // Message confidentiality enforced by AES-256-GCM E2E encryption
    match /qc-chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false; // Chats cannot be deleted by clients

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Allowed mutable keys: reactions (toggle), poll (vote), hiddenBy (delete-for-me),
        // and the edit triplet (text + encEpoch + editedAt). Edit is only valid on
        // text messages by the sender; app-level logic enforces the 15-min window
        // and sender check — rules enforce the key allow-list.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'reactions', 'poll', 'hiddenBy', 'text', 'encEpoch', 'editedAt',
                'type', 'deletedForEveryone', 'deletedAt', 'encrypted', 'expiresAt',
                'replyTo', 'forwarded', 'voice', 'file', 'transfer', 'nftShare', 'call'
              ]);
        allow delete: if request.auth != null;
      }
    }

    // QC Presence - user online/offline status
    match /qc-presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // QC Calls - 1:1 voice calls (WebRTC signaling via Firestore)
    match /qc-calls/{callId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;

      match /callerCandidates/{cid} {
        allow read, create: if request.auth != null;
      }
      match /calleeCandidates/{cid} {
        allow read, create: if request.auth != null;
      }
    }

    // QC Group Calls - multi-user voice calls via WebRTC + Firestore signaling
    match /qc-group-calls/{callId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;

      match /signals/{signalId} {
        allow read, create: if request.auth != null;
      }
    }

    // QC Usernames - public read for lookups, write via Admin SDK only
    match /qcUsernames/{usernameId} {
      allow read: if true; // Anyone can check username availability / resolve
      allow write: if false; // Only API routes with Admin SDK can write
    }

    // NFT Marketplace collections - server-only via Admin SDK
    match /nft_listings/{listingId} {
      allow read: if true; // Public read for marketplace browsing
      allow write: if false; // Only server actions with Admin SDK can write
    }

    match /nft_sales/{saleId} {
      allow read: if request.auth != null; // Authenticated users can view sales history
      allow write: if false; // Only server actions with Admin SDK can write
    }

    match /marketplace_stats/{statId} {
      allow read: if true; // Public read for stats display
      allow write: if false; // Only server actions with Admin SDK can write
    }

    match /pending_star_payments/{paymentId} {
      allow read, write: if false; // Server-only — sensitive payment data
    }

    // QC Broadcasts — Telegram-channel-like one-to-many feeds.
    // All mutations to broadcast docs, posts, admin roster, and verification
    // approvals run via Admin SDK (server actions). Clients can only mutate
    // their own subscription doc and their own reaction under userReactions.
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if false; // Server-only — creation happens via approval script

      // Posts: authored by admins, read by anyone authenticated.
      // Reactions counters are updated via transaction in server actions.
      match /posts/{postId} {
        allow read: if request.auth != null;
        allow write: if false; // Server-only

        // Per-user reaction doc — each user tracks which emoji they chose.
        // Written only by the owning user; the aggregate reactions map on
        // the post doc is kept in sync via a server-side transaction.
        // Reactions stay anonymous: only the user themselves can see their own
        // doc; admins see aggregate counts only via the post's reactions map.
        match /userReactions/{userId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false; // Server-only (transactional counter + doc)
        }

        // Per-user viewer dedup doc — counts each user once. Private to the
        // user; admins see aggregate viewCount on the post only.
        match /viewers/{userId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false; // Server-only (transactional increment)
        }
      }

      // Admin roster — private. Only the admin themselves can read their doc;
      // no client writes (roster is managed by owner via server actions).
      match /admins/{adminId} {
        allow read: if request.auth != null && request.auth.uid == adminId;
        allow write: if false;
      }

      // Subscribers — each user owns their own subscription doc.
      // Readable by the subscriber themselves, and by admins of this broadcast
      // (admins need the list for their dashboard). Writes are server-only.
      match /subscribers/{userId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId
              || exists(/databases/$(database)/documents/broadcasts/$(broadcastId)/admins/$(request.auth.uid)));
        allow write: if false;
      }
    }

    // Broadcast handle → id lookup. Public read for handle resolution,
    // server-only write (created at approval time).
    match /broadcastHandles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // Verification requests — any auth'd user can submit a request for
    // themselves; only the requester can read their own request.
    match /verificationRequests/{requestId} {
      allow read: if request.auth != null
        && resource.data.requesterQcId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.requesterQcId == request.auth.uid;
      allow update, delete: if false; // Server-only moderation
    }
  }
}
