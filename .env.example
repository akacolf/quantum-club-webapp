# ==============================================================================
# Quantum Club Web App — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Do NOT commit actual secrets or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Admin SDK (Server)
# Generated from Firebase Console -> Project Settings -> Service Accounts
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID="your-private-key-id"
FIREBASE_CLIENT_ID="your-client-id"

# ------------------------------------------------------------------------------
# 2. Authentication & Data Encryption (Server)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="your-jwt-secret-min-32-characters-long"
# 256-bit key (at least 32 characters) for AES server encryption
AES_ENCRYPTION_KEY="your-aes-256-encryption-key-at-least-32-chars"

# ------------------------------------------------------------------------------
# 3. Telegram Bot Configuration (Server)
# Obtain from @BotFather on Telegram
# ------------------------------------------------------------------------------
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
DEV_BOT_TOKEN=""
BOT_USERNAME="QuantumClubBot"
# Random string for validating Telegram webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_BOT_WEBHOOK_SECRET="your-telegram-webhook-secret-token"

# ------------------------------------------------------------------------------
# 4. AI & LLM Assistants (Server)
# From Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 5. Platform Wallet & Administration (Server)
# Platform operator wallet for bonding curves, fee sweeps, and creator payouts
# ------------------------------------------------------------------------------
ADMIN_API_KEY="your-secure-admin-api-key"
ADMIN_TELEGRAM_IDS="123456789,987654321"
# 24-word space-separated mnemonic phrase for the platform operator wallet
PLATFORM_WALLET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"
# Supported versions: "v5r1" (default) or "v4r2"
PLATFORM_WALLET_VERSION="v5r1"

# ------------------------------------------------------------------------------
# 6. Scheduled Tasks / Cron (Server)
# Secret bearer token to secure Vercel or external cron endpoints
# ------------------------------------------------------------------------------
CRON_SECRET="your-secure-cron-job-bearer-secret"

# ------------------------------------------------------------------------------
# 7. Media Uploads — Cloudinary (Server - Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 8. WebRTC Audio & Calls — Cloudflare TURN (Server - Optional)
# ------------------------------------------------------------------------------
CLOUDFLARE_TURN_KEY_ID="your-cloudflare-turn-key-id"
CLOUDFLARE_TURN_API_TOKEN="your-cloudflare-turn-api-token"

# ------------------------------------------------------------------------------
# 9. TON API & Analytics (Server)
# Obtain from https://tonapi.io
# ------------------------------------------------------------------------------
TONAPI_KEY="your-server-side-tonapi-key"
TGA_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# 10. Upstash Redis — Rate Limiting (Server - Optional)
# If omitted, rate limiting fails open with a warning in development
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ------------------------------------------------------------------------------
# 11. Firebase Web SDK (Client)
# From Firebase Console -> Project Settings -> General -> Web Apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKey"
NEXT_PUBLIC_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_PROJECT_ID="your-project-id"
NEXT_PUBLIC_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_SENDER_ID="123456789012"
NEXT_PUBLIC_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 12. TON Blockchain & Client Settings (Client)
# ------------------------------------------------------------------------------
# Address of the platform wallet where trading & service fees are sent
NEXT_PUBLIC_PLATFORM_WALLET="UQXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# Public TON API client key from tonapi.io
NEXT_PUBLIC_TONAPI_KEY="your-client-tonapi-key"
# "mainnet" or "testnet"
NEXT_PUBLIC_TON_NETWORK="mainnet"
