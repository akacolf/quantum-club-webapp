{
    "name": "quantum-club-functions",
    "version": "1.0.0",
    "description": "Firebase Cloud Functions for QC RocketStart token graduation",
    "main": "lib/index.js",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "20"
    },
    "dependencies": {
        "@ston-fi/api": "^0.29.0",
        "@ston-fi/sdk": "^2.7.0",
        "@ton/core": "^0.62.0",
        "@ton/crypto": "^3.3.0",
        "@ton/ton": "^15.1.0",
        "firebase-admin": "^12.0.0",
        "firebase-functions": "^5.0.0"
    },
    "devDependencies": {
        "typescript": "^5.3.0"
    },
    "private": true
}