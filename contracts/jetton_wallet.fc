;; ================================================================
;; QC RocketStart - Jetton Wallet Contract
;; ================================================================
;; TEP-74 Compliant Jetton Wallet
;; 
;; Features:
;; - Standard jetton transfers
;; - Token burning (for sells)
;; - Transfer notifications
;; ================================================================

#include "imports/stdlib.fc";
#include "imports/opcodes.fc";
#include "imports/errors.fc";
#include "imports/constants.fc";
#include "imports/utils.fc";

;; ================================================================
;; Storage
;; ================================================================
;; balance:coins owner:MsgAddr master:MsgAddr wallet_code:^Cell
;; ================================================================

(int, slice, slice, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_coins(),      ;; balance
        ds~load_msg_addr(),   ;; owner_address
        ds~load_msg_addr(),   ;; jetton_master_address
        ds~load_ref()         ;; jetton_wallet_code
    );
}

() save_data(int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) impure inline {
    set_data(begin_cell()
        .store_coins(balance)
        .store_slice(owner_address)
        .store_slice(jetton_master_address)
        .store_ref(jetton_wallet_code)
        .end_cell()
    );
}

;; ================================================================
;; Send Tokens to Another Wallet
;; ================================================================

() send_tokens(
    slice to_address,
    slice jetton_master_address,
    cell jetton_wallet_code,
    int jetton_amount,
    slice response_address,
    int forward_ton_amount,
    cell forward_payload,
    int msg_value
) impure inline {
    cell state_init = calculate_jetton_wallet_state_init(
        to_address,
        jetton_master_address,
        jetton_wallet_code
    );
    slice to_wallet = calculate_jetton_wallet_address(state_init);
    
    cell body = begin_cell()
        .store_uint(op::internal_transfer, 32)
        .store_uint(0, 64)
        .store_coins(jetton_amount)
        .store_slice(my_address())
        .store_slice(response_address)
        .store_coins(forward_ton_amount)
        .store_uint(0, 1)
        .end_cell();
    
    if (~ cell_null?(forward_payload)) {
        body = begin_cell()
            .store_uint(op::internal_transfer, 32)
            .store_uint(0, 64)
            .store_coins(jetton_amount)
            .store_slice(my_address())
            .store_slice(response_address)
            .store_coins(forward_ton_amount)
            .store_uint(1, 1)
            .store_ref(forward_payload)
            .end_cell();
    }
    
    cell message = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(to_wallet)
        .store_coins(msg_value)
        .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
        .store_ref(state_init)
        .store_ref(body)
        .end_cell();
    
    send_raw_message(message, 64);
}

;; ================================================================
;; Transfer Handler
;; ================================================================

() handle_transfer(
    slice sender_address,
    int msg_value,
    int query_id,
    slice in_msg_body
) impure inline {
    (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
    
    ;; Only owner can transfer
    throw_unless(error::not_owner, equal_slices(sender_address, owner_address));
    
    int jetton_amount = in_msg_body~load_coins();
    slice to_address = in_msg_body~load_msg_addr();
    slice response_address = in_msg_body~load_msg_addr();
    in_msg_body~skip_bits(1);  ;; skip custom_payload flag
    int forward_ton_amount = in_msg_body~load_coins();
    
    ;; Calculate gas needed
    int fwd_count = 1;
    if (forward_ton_amount > 0) {
        fwd_count = 2;
    }
    
    throw_unless(error::insufficient_gas, msg_value > fwd_count * FORWARD_FEE + GAS_CONSUMPTION);
    throw_unless(error::insufficient_balance, balance >= jetton_amount);
    
    ;; Parse optional forward payload
    cell forward_payload = null();
    if (in_msg_body~load_uint(1)) {
        forward_payload = in_msg_body~load_ref();
    }
    
    ;; Update balance
    balance -= jetton_amount;
    save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
    
    ;; Send tokens
    send_tokens(
        to_address,
        jetton_master_address,
        jetton_wallet_code,
        jetton_amount,
        response_address,
        forward_ton_amount,
        forward_payload,
        msg_value - GAS_CONSUMPTION
    );
}

;; ================================================================
;; Internal Transfer Handler (Receiving tokens)
;; ================================================================

() handle_internal_transfer(
    slice sender_address,
    int msg_value,
    int query_id,
    slice in_msg_body
) impure inline {
    (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
    
    int jetton_amount = in_msg_body~load_coins();
    slice from_address = in_msg_body~load_msg_addr();
    slice response_address = in_msg_body~load_msg_addr();
    int forward_ton_amount = in_msg_body~load_coins();
    
    ;; Verify sender is master or valid wallet
    int is_master = equal_slices(sender_address, jetton_master_address);
    if (~ is_master) {
        slice expected_wallet = get_jetton_wallet_address(from_address, jetton_master_address, jetton_wallet_code);
        throw_unless(error::not_valid_wallet, equal_slices(sender_address, expected_wallet));
    }
    
    ;; Credit tokens
    balance += jetton_amount;
    save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
    
    ;; Send transfer notification if requested
    if (forward_ton_amount > 0) {
        cell notify_body = begin_cell()
            .store_uint(op::transfer_notification, 32)
            .store_uint(query_id, 64)
            .store_coins(jetton_amount)
            .store_slice(from_address)
            .end_cell();
        
        ;; Check for forward payload
        if (in_msg_body~load_uint(1)) {
            cell forward_payload = in_msg_body~load_ref();
            notify_body = begin_cell()
                .store_uint(op::transfer_notification, 32)
                .store_uint(query_id, 64)
                .store_coins(jetton_amount)
                .store_slice(from_address)
                .store_uint(1, 1)
                .store_ref(forward_payload)
                .end_cell();
        }
        
        cell message = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(owner_address)
            .store_coins(forward_ton_amount)
            .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_ref(notify_body)
            .end_cell();
        
        send_raw_message(message, 1);
    }
    
    ;; Send excesses back
    if ((response_address.preload_uint(2) != 0) & (msg_value > forward_ton_amount + GAS_CONSUMPTION)) {
        send_excesses(response_address, query_id);
    }
}

;; ================================================================
;; Burn Handler (For selling tokens)
;; ================================================================

() handle_burn(
    slice sender_address,
    int msg_value,
    int query_id,
    slice in_msg_body
) impure inline {
    (int balance, slice owner_address, slice jetton_master_address, cell jetton_wallet_code) = load_data();
    
    ;; Only owner can burn
    throw_unless(error::not_owner, equal_slices(sender_address, owner_address));
    
    int jetton_amount = in_msg_body~load_coins();
    slice response_address = in_msg_body~load_msg_addr();
    
    throw_unless(error::insufficient_balance, balance >= jetton_amount);
    throw_unless(error::insufficient_gas, msg_value > GAS_CONSUMPTION + FORWARD_FEE);
    
    ;; Deduct tokens
    balance -= jetton_amount;
    save_data(balance, owner_address, jetton_master_address, jetton_wallet_code);
    
    ;; Notify master (triggers sell)
    cell body = begin_cell()
        .store_uint(op::burn_notification, 32)
        .store_uint(query_id, 64)
        .store_coins(jetton_amount)
        .store_slice(owner_address)
        .store_slice(response_address)
        .end_cell();
    
    cell message = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(jetton_master_address)
        .store_coins(msg_value - GAS_CONSUMPTION)
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(body)
        .end_cell();
    
    send_raw_message(message, 64);
}

;; ================================================================
;; Main Entry Point
;; ================================================================

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    
    ;; Ignore bounced messages
    if (flags & 1) {
        return ();
    }
    
    slice sender_address = cs~load_msg_addr();
    
    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);
    
    ;; ----- TRANSFER -----
    if (op == op::transfer) {
        handle_transfer(sender_address, msg_value, query_id, in_msg_body);
        return ();
    }
    
    ;; ----- INTERNAL TRANSFER (Receive) -----
    if (op == op::internal_transfer) {
        handle_internal_transfer(sender_address, msg_value, query_id, in_msg_body);
        return ();
    }
    
    ;; ----- BURN -----
    if (op == op::burn) {
        handle_burn(sender_address, msg_value, query_id, in_msg_body);
        return ();
    }
    
    throw(error::invalid_op);
}

;; ================================================================
;; GET Methods
;; ================================================================

;; TEP-74 Standard: Get Wallet Data
(int, slice, slice, cell) get_wallet_data() method_id {
    return load_data();
}
