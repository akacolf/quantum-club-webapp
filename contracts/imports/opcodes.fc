;; ================================================================
;; QC RocketStart - Operation Codes
;; ================================================================
;; TEP-74 Jetton Standard + Custom Trading Operations
;; ================================================================

;; ----- TEP-74 Standard Jetton Operations -----
const int op::transfer = 0xf8a7ea5;
const int op::transfer_notification = 0x7362d09c;
const int op::internal_transfer = 0x178d4519;
const int op::excesses = 0xd53276db;
const int op::burn = 0x595f07bc;
const int op::burn_notification = 0x7bdd97de;

;; ----- Bonding Curve Trading Operations -----
const int op::buy = 0xaf750d34;              ;; Buy tokens with TON
const int op::sell_request = 0x742b36d8;     ;; Initiate token sell
const int op::sell_notification = 0xb7e76bfd; ;; Burn notification for sells

;; ----- Admin Operations -----
const int op::mint = 0x15;
const int op::change_admin = 0x3;
const int op::upgrade = 0x4;
const int op::claim = 0x4e400a03;
const int op::withdraw_fees = 0x46454553;    ;; "FEES" in hex

;; ----- Graduation Operations -----
const int op::graduate = 0x47524144;         ;; "GRAD" in hex

;; ----- Fee Payment Identifier -----
const int op::fee_payment = 0xfdaa7c9d;

;; ----- External Log Operations (for indexers) -----
const int log::deploy = 0x44455059;          ;; "DEPY" - Contract deployed
const int log::buy = 0x42555921;             ;; "BUY!" - Token purchased
const int log::sell = 0x53454c4c;            ;; "SELL" - Token sold
const int log::graduate = 0x47524144;        ;; "GRAD" - Token graduated to DEX
