// ----- General Errors (100-109) -----
const ERROR_INSUFFICIENT_GAS = 100
const ERROR_NOT_ADMIN = 101
const ERROR_NOT_OWNER = 102
const ERROR_NOT_FROM_WALLET = 103
const ERROR_ALREADY_GRADUATED = 104
const ERROR_NOT_GRADUATED = 105
const ERROR_INSUFFICIENT_BALANCE = 106
const ERROR_INSUFFICIENT_LIQUIDITY = 107
const ERROR_ZERO_AMOUNT = 108
const ERROR_SLIPPAGE_EXCEEDED = 109

// ----- Wallet-Specific Errors (110-119) -----
const ERROR_NOT_MASTER = 110
const ERROR_NOT_VALID_WALLET = 111

// ----- System Errors -----
const ERROR_INVALID_OP = 0xffff
