;; ================================================================
;; QC RocketStart - Shared Utilities
;; ================================================================
;; Common functions used across all contracts
;; ================================================================

#include "constants.fc";
#include "opcodes.fc";

;; ----- Slice Comparison -----
int equal_slices(slice a, slice b) asm "SDEQ";

;; ----- Pack Jetton Wallet Data -----
cell pack_jetton_wallet_data(slice owner_address, slice jetton_master_address, cell jetton_wallet_code) inline {
    return begin_cell()
        .store_coins(0)
        .store_slice(owner_address)
        .store_slice(jetton_master_address)
        .store_ref(jetton_wallet_code)
        .end_cell();
}

;; ----- Calculate Jetton Wallet StateInit -----
cell calculate_jetton_wallet_state_init(slice owner_address, slice jetton_master_address, cell jetton_wallet_code) inline {
    return begin_cell()
        .store_uint(0, 2)
        .store_dict(jetton_wallet_code)
        .store_dict(pack_jetton_wallet_data(owner_address, jetton_master_address, jetton_wallet_code))
        .store_uint(0, 1)
        .end_cell();
}

;; ----- Calculate Address from StateInit -----
slice calculate_jetton_wallet_address(cell state_init) inline {
    return begin_cell()
        .store_uint(4, 3)
        .store_int(0, 8)
        .store_uint(cell_hash(state_init), 256)
        .end_cell()
        .begin_parse();
}

;; ----- Get Jetton Wallet Address for Owner -----
slice get_jetton_wallet_address(slice owner_address, slice jetton_master_address, cell jetton_wallet_code) inline {
    cell state_init = calculate_jetton_wallet_state_init(owner_address, jetton_master_address, jetton_wallet_code);
    return calculate_jetton_wallet_address(state_init);
}

;; ----- Send Message with Reserve -----
() send_msg_with_reserve(cell message, int mode) impure inline {
    raw_reserve(MIN_TON_FOR_STORAGE, 0);
    send_raw_message(message, mode);
}

;; ----- Send Excesses (Refund) -----
() send_excesses(slice to_address, int query_id) impure inline {
    cell message = begin_cell()
        .store_uint(0x10, 6)
        .store_slice(to_address)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(op::excesses, 32)
        .store_uint(query_id, 64)
        .end_cell();
    
    send_raw_message(message, 64 + 128);
}

;; ----- Send Fee Payment -----
() send_fee(slice to_address, int amount, int query_id) impure inline {
    if (amount > 0) {
        cell message = begin_cell()
            .store_uint(0x10, 6)
            .store_slice(to_address)
            .store_coins(amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::fee_payment, 32)
            .store_uint(query_id, 64)
            .end_cell();
        
        send_raw_message(message, 1);
    }
}

;; ----- Emit External Log -----
;; Emits an external message for indexers to track events
() emit_log(int log_op, slice user, int amount, int price) impure inline {
    ;; Build log data
    cell log = begin_cell()
        .store_uint(log_op, 32)
        .store_uint(now(), 64)
        .store_slice(user)
        .store_coins(amount)
        .store_coins(price)
        .end_cell();
    
    ;; Send as external out message with proper format
    ;; ext_out_msg_info$11 src:MsgAddressInt dest:MsgAddressExt created_lt:uint64 created_at:uint32
    cell msg = begin_cell()
        .store_uint(3, 2)          ;; ext_out_msg_info tag (11 in binary = 3)
        .store_slice(my_address()) ;; src: contract address
        .store_uint(0, 2)          ;; dest: addr_none (00 in binary)
        .store_uint(0, 64 + 32)    ;; created_lt, created_at (filled by validator)
        .store_uint(0, 1)          ;; no init
        .store_uint(1, 1)          ;; body in ref
        .store_ref(log)
        .end_cell();
    
    send_raw_message(msg, 0);
}
