;; =============================================================================
;; Quantum Club NFT Fixed Price Sale Contract
;; =============================================================================
;;
;; This contract enables in-house NFT trading with only 0.5% marketplace fee
;; (compared to Getgems' 5%)
;;
;; Sale Flow:
;; 1. Seller deploys this contract with NFT address, price, and fee settings
;; 2. Seller transfers NFT to this contract (NFT ownership changes to sale contract)
;; 3. Buyer sends TON >= full_price to this contract
;; 4. Contract transfers NFT to buyer, distributes TON to seller/marketplace/royalty
;; 5. Contract self-destructs after successful sale
;;
;; Based on TEP-62 (NFT Standard) and Getgems nft-fixprice-sale-v3 patterns
;; =============================================================================

#include "imports/stdlib.fc";
#include "imports/nft_opcodes.fc";
#include "imports/nft_errors.fc";

;; =============================================================================
;; Storage Layout
;; =============================================================================
;;
;; Data cell structure:
;; - is_complete: 1 bit (0 = active, 1 = sold/cancelled)
;; - created_at: 32 bits (unix timestamp)
;; - marketplace_address: MsgAddress (QC fee recipient)
;; - nft_address: MsgAddress
;; - nft_owner_address: MsgAddress (seller, receives payment)
;; - full_price: Coins (price buyer pays)
;; - ref -> fees_cell:
;;   - marketplace_fee_address: MsgAddress
;;   - marketplace_fee: Coins (0.5% of price)
;;   - royalty_address: MsgAddress (creator)
;;   - royalty_amount: Coins (creator royalty)
;; =============================================================================

;; Gas constants
const int min_gas_amount = 50000000;    ;; 0.05 TON
const int gas_for_nft_transfer = 50000000;  ;; 0.05 TON for NFT transfer

;; Load contract data
(int, int, slice, slice, slice, int, slice, int, slice, int) load_data() inline {
    slice ds = get_data().begin_parse();
    
    int is_complete = ds~load_uint(1);
    int created_at = ds~load_uint(32);
    slice marketplace_address = ds~load_msg_addr();
    slice nft_address = ds~load_msg_addr();
    slice nft_owner_address = ds~load_msg_addr();
    int full_price = ds~load_coins();
    
    ;; Load fees from ref
    slice fees = ds~load_ref().begin_parse();
    slice marketplace_fee_address = fees~load_msg_addr();
    int marketplace_fee = fees~load_coins();
    slice royalty_address = fees~load_msg_addr();
    int royalty_amount = fees~load_coins();
    
    return (
        is_complete,
        created_at,
        marketplace_address,
        nft_address,
        nft_owner_address,
        full_price,
        marketplace_fee_address,
        marketplace_fee,
        royalty_address,
        royalty_amount
    );
}

;; Save contract data
() save_data(
    int is_complete,
    int created_at,
    slice marketplace_address,
    slice nft_address,
    slice nft_owner_address,
    int full_price,
    slice marketplace_fee_address,
    int marketplace_fee,
    slice royalty_address,
    int royalty_amount
) impure inline {
    cell fees_cell = begin_cell()
        .store_slice(marketplace_fee_address)
        .store_coins(marketplace_fee)
        .store_slice(royalty_address)
        .store_coins(royalty_amount)
        .end_cell();
    
    set_data(
        begin_cell()
            .store_uint(is_complete, 1)
            .store_uint(created_at, 32)
            .store_slice(marketplace_address)
            .store_slice(nft_address)
            .store_slice(nft_owner_address)
            .store_coins(full_price)
            .store_ref(fees_cell)
            .end_cell()
    );
}

;; =============================================================================
;; Send Functions
;; =============================================================================

;; Send TON to an address
() send_ton(slice to_address, int amount, int mode) impure inline {
    if (amount > 0) {
        cell msg = begin_cell()
            .store_uint(0x10, 6)  ;; nobounce
            .store_slice(to_address)
            .store_coins(amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .end_cell();
        send_raw_message(msg, mode);
    }
}

;; Send TON with comment
() send_ton_with_comment(slice to_address, int amount, slice comment, int mode) impure inline {
    if (amount > 0) {
        cell msg = begin_cell()
            .store_uint(0x10, 6)  ;; nobounce
            .store_slice(to_address)
            .store_coins(amount)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1)
            .store_uint(1, 1)  ;; has body
            .store_ref(
                begin_cell()
                    .store_uint(0, 32)  ;; text comment op
                    .store_slice(comment)
                    .end_cell()
            )
            .end_cell();
        send_raw_message(msg, mode);
    }
}

;; Transfer NFT to new owner
() transfer_nft(
    slice nft_address,
    slice new_owner,
    slice response_destination,
    int forward_amount
) impure inline {
    cell nft_transfer_body = begin_cell()
        .store_uint(op::transfer, 32)
        .store_uint(0, 64)  ;; query_id
        .store_slice(new_owner)
        .store_slice(response_destination)
        .store_uint(0, 1)  ;; no custom_payload
        .store_coins(forward_amount)
        .store_uint(0, 1)  ;; no forward_payload
        .end_cell();
    
    cell msg = begin_cell()
        .store_uint(0x18, 6)  ;; bounce
        .store_slice(nft_address)
        .store_coins(gas_for_nft_transfer)
        .store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_ref(nft_transfer_body)
        .end_cell();
    
    send_raw_message(msg, 1);  ;; pay fees separately
}

;; =============================================================================
;; Buy NFT
;; =============================================================================

() buy_nft(
    slice sender_address,
    int msg_value,
    int is_complete,
    int created_at,
    slice marketplace_address,
    slice nft_address,
    slice nft_owner_address,
    int full_price,
    slice marketplace_fee_address,
    int marketplace_fee,
    slice royalty_address,
    int royalty_amount
) impure {
    ;; Check if sale is active
    throw_if(error::already_sold, is_complete);
    
    ;; Check sufficient funds
    throw_unless(error::not_enough_funds, msg_value >= full_price + min_gas_amount);
    
    ;; Calculate seller amount (price - fees)
    int seller_amount = full_price - marketplace_fee - royalty_amount;
    
    ;; Mark as complete
    save_data(
        1,  ;; is_complete = true
        created_at,
        marketplace_address,
        nft_address,
        nft_owner_address,
        full_price,
        marketplace_fee_address,
        marketplace_fee,
        royalty_address,
        royalty_amount
    );
    
    ;; 1. Transfer NFT to buyer
    transfer_nft(nft_address, sender_address, sender_address, 1);
    
    ;; 2. Send marketplace fee
    send_ton(marketplace_fee_address, marketplace_fee, 1);
    
    ;; 3. Send royalty to creator (if any)
    if (royalty_amount > 0) {
        send_ton(royalty_address, royalty_amount, 1);
    }
    
    ;; 4. Send remaining to seller (with all remaining balance)
    send_ton(nft_owner_address, 0, 128);  ;; mode 128 = send remaining balance
}

;; =============================================================================
;; Cancel Sale
;; =============================================================================

() cancel_sale(
    slice sender_address,
    int is_complete,
    int created_at,
    slice marketplace_address,
    slice nft_address,
    slice nft_owner_address,
    int full_price,
    slice marketplace_fee_address,
    int marketplace_fee,
    slice royalty_address,
    int royalty_amount
) impure {
    ;; Only seller can cancel (compare by hash)
    throw_unless(error::unauthorized, slice_hash(sender_address) == slice_hash(nft_owner_address));
    
    ;; Check if sale is still active
    throw_if(error::already_sold, is_complete);
    
    ;; Mark as complete
    save_data(
        1,  ;; is_complete = true
        created_at,
        marketplace_address,
        nft_address,
        nft_owner_address,
        full_price,
        marketplace_fee_address,
        marketplace_fee,
        royalty_address,
        royalty_amount
    );
    
    ;; Return NFT to seller
    transfer_nft(nft_address, nft_owner_address, nft_owner_address, 1);
    
    ;; Return remaining balance to seller
    send_ton(nft_owner_address, 0, 128 + 32);  ;; 128 = remaining, 32 = destroy if zero
}

;; =============================================================================
;; Handle NFT Ownership Assigned (when NFT is transferred to this contract)
;; =============================================================================

() on_nft_received(
    slice sender_address,
    int msg_value,
    slice in_msg_body,
    slice nft_address,
    slice nft_owner_address
) impure {
    ;; Verify the NFT address matches (compare by hash)
    throw_unless(error::wrong_nft, slice_hash(sender_address) == slice_hash(nft_address));
    
    ;; Parse ownership_assigned message
    ;; int query_id = in_msg_body~load_uint(64);
    ;; slice prev_owner = in_msg_body~load_msg_addr();
    
    ;; NFT is now held by this contract, sale is active
    ;; No action needed, contract is ready for buyers
}

;; =============================================================================
;; Main Entry Point
;; =============================================================================

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    ;; Ignore empty messages
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    
    ;; Parse incoming message
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    
    ;; Ignore bounced messages
    if (flags & 1) {
        return ();
    }
    
    slice sender_address = cs~load_msg_addr();
    
    ;; Load contract data
    (
        int is_complete,
        int created_at,
        slice marketplace_address,
        slice nft_address,
        slice nft_owner_address,
        int full_price,
        slice marketplace_fee_address,
        int marketplace_fee,
        slice royalty_address,
        int royalty_amount
    ) = load_data();
    
    ;; Parse operation code
    int op = in_msg_body~load_uint(32);
    
    ;; Handle NFT ownership assigned (NFT transferred to this contract)
    if (op == op::ownership_assigned) {
        on_nft_received(
            sender_address, msg_value, in_msg_body,
            nft_address, nft_owner_address
        );
        return ();
    }
    
    ;; Handle buy
    if (op == op::buy) {
        buy_nft(
            sender_address, msg_value,
            is_complete, created_at, marketplace_address,
            nft_address, nft_owner_address, full_price,
            marketplace_fee_address, marketplace_fee,
            royalty_address, royalty_amount
        );
        return ();
    }
    
    ;; Handle cancel
    if (op == op::cancel) {
        cancel_sale(
            sender_address,
            is_complete, created_at, marketplace_address,
            nft_address, nft_owner_address, full_price,
            marketplace_fee_address, marketplace_fee,
            royalty_address, royalty_amount
        );
        return ();
    }
    
    ;; Unknown operation - accept as buy attempt if enough TON sent
    ;; This allows users to buy by just sending TON without specific op
    if (msg_value >= full_price) {
        buy_nft(
            sender_address, msg_value,
            is_complete, created_at, marketplace_address,
            nft_address, nft_owner_address, full_price,
            marketplace_fee_address, marketplace_fee,
            royalty_address, royalty_amount
        );
        return ();
    }
    
    ;; Reject unknown operations with insufficient funds
    throw(0xffff);
}

;; =============================================================================
;; GET Methods
;; =============================================================================

;; Get sale data - compatible with Getgems format
(int, int, int, slice, slice, slice, int, slice, int, slice, int) get_sale_data() method_id {
    (
        int is_complete,
        int created_at,
        slice marketplace_address,
        slice nft_address,
        slice nft_owner_address,
        int full_price,
        slice marketplace_fee_address,
        int marketplace_fee,
        slice royalty_address,
        int royalty_amount
    ) = load_data();
    
    ;; Return: magic, is_complete, created_at, marketplace, nft, owner, price, fee_addr, fee, royalty_addr, royalty
    return (
        0x46495850,  ;; "FIXP" magic number
        is_complete,
        created_at,
        marketplace_address,
        nft_address,
        nft_owner_address,
        full_price,
        marketplace_fee_address,
        marketplace_fee,
        royalty_address,
        royalty_amount
    );
}

;; Get NFT address
slice get_nft_address() method_id {
    (_, _, _, slice nft_address, _, _, _, _, _, _) = load_data();
    return nft_address;
}

;; Get price
int get_full_price() method_id {
    (_, _, _, _, _, int full_price, _, _, _, _) = load_data();
    return full_price;
}

;; Get sale status
int is_sale_complete() method_id {
    (int is_complete, _, _, _, _, _, _, _, _, _) = load_data();
    return is_complete;
}

;; Get seller address
slice get_seller_address() method_id {
    (_, _, _, _, slice nft_owner_address, _, _, _, _, _) = load_data();
    return nft_owner_address;
}
