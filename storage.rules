rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Voice messages: authenticated users can upload/read
    // Supports both unencrypted (audio/*) and encrypted (application/octet-stream) voice messages
    match /voice-messages/{chatId}/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('audio/.*')
                       || request.resource.contentType == 'application/octet-stream');
    }

    // Chat files (images, documents): authenticated users can upload/read.
    // Cap at 11 MiB to allow ~10 MB raw + encryption envelope overhead
    // (the client UI rejects raw files over 10 MB - 256 bytes).
    match /chat-files/{chatId}/{messageId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 11 * 1024 * 1024;
    }

    // Profile photos: public read (avatars are broadcast), owner-only write.
    // 2MB cap + image/* content-type enforces client-side resize/compress.
    match /profile-photos/{userId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // QC Social post media. Public read since posts are public; writes are
    // owner-only (uid path prefix). Same content-type + size guards as
    // broadcasts. Orphaned blobs are possible but never referenced because
    // the Firestore post doc is only written by the server action.
    match /social-posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Broadcast media (avatar, cover, post images). Public read since
    // broadcasts are verified and public by product definition.
    //
    // Writes are gated on auth + size + content-type only — admin-only
    // enforcement happens at the server-action layer (publishPost /
    // updateBroadcast), which is where URLs get persisted to Firestore.
    // A non-admin could upload a blob but it would never be referenced
    // by any broadcast or post (orphaned file; storage cost only).
    // This avoids relying on cross-service Firestore lookups from
    // Storage rules, which require project-level opt-in and fail
    // silently when unavailable.
    match /broadcasts/{broadcastId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
