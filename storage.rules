rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Token images - public read, authenticated write with restrictions
    match /token-images/{imageId} {
      // Anyone can read token images
      allow read: if true;
      
      // Write only if:
      // - File is less than 2MB
      // - File is an image type (png, jpg, gif, webp)
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp)');
    }
    
    // Profile images / avatars
    match /profile-images/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp)');
    }
    
    // Group images
    match /group-images/{groupId}/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp)');
    }
    
    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
